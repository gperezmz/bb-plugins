{
  "name": "@gperezmz/bb-plugin-cache-keeper",
  "version": "0.3.0",
  "type": "module",
  "engines": {
    "bb": ">=0.44",
    "bbPluginSdk": ">=0.5.29"
  },
  "bb": {
    "name": "Cache Keeper",
    "description": "Keeps idle Claude Code threads cheap to come back to: compacts them just before their prompt cache goes cold, and keeps threads waiting on background work warm.",
    "branding": {
      "icon": "./icons/timer.svg",
      "experimental_icons": {
        "cache-keeper": "./icons/timer.svg",
        "flame": "./icons/flame.svg",
        "crossed-out-flame": "./icons/crossed-out-flame.svg"
      }
    },
    "server": "./server.ts",
    "app": "./app.tsx",
    "host": "./host.ts"
  },
  "description": "Compacts idle Claude Code threads in bb before their prompt cache goes cold, and keeps threads waiting on background work warm.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/gperezmz/bb-plugins.git",
    "directory": "plugins/cache-keeper"
  },
  "keywords": [
    "bb-plugin"
  ],
  "scripts": {
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "build": "bb plugin build",
    "prices": "node scripts/update-prices.mjs",
    "notices": "node scripts/third-party-notices.mjs",
    "bench": "node bench/run.mjs"
  },
  "files": [
    "dist",
    "server.ts",
    "app.tsx",
    "host.ts",
    "tsconfig.json",
    "THIRD_PARTY_NOTICES.md",
    "src",
    "features",
    "components",
    "lib",
    "icons",
    "prices",
    "!**/*.test.*"
  ],
  "dependencies": {
    "@radix-ui/react-slot": "^1.3.3",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@get-bb/plugin-sdk": "0.5.29",
    "@radix-ui/react-popover": "^1.1.19",
    "@radix-ui/react-tooltip": "^1.2.12",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/react": "^16.3.3",
    "@types/better-sqlite3": "^7.6.13",
    "@types/node": "^22.20.4",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "better-sqlite3": "^12.11.1",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cron-parser": "^5.10.1",
    "esbuild": "^0.28.2",
    "hono": "^4.13.9",
    "jsdom": "^30.1.1",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "tailwind-merge": "^3.4.0",
    "typescript": "^7.0.2",
    "vitest": "^5.0.2"
  }
}
