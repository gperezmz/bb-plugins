{
  "name": "@gperezmz/bb-plugin-unattendish-sdlc",
  "version": "0.1.0",
  "type": "module",
  "engines": {
    "bb": ">=0.46",
    "bbPluginSdk": ">=0.6.37"
  },
  "bb": {
    "name": "Unattendish",
    "description": "Wakes the manager thread of an Unattendish fleet when its tracker or forge changes, so the fleet moves when the operator answers, reviews or marks a spec ready.",
    "branding": {
      "icon": "./icons/fleet.svg",
      "experimental_icons": {
        "circle-dashed": "./icons/circle-dashed.svg",
        "fleet": "./icons/fleet.svg",
        "hammer": "./icons/hammer.svg",
        "hourglass": "./icons/hourglass.svg",
        "key": "./icons/key.svg",
        "lightbulb": "./icons/lightbulb.svg",
        "rocket": "./icons/rocket.svg",
        "scale": "./icons/scale.svg",
        "user-x": "./icons/user-x.svg"
      }
    },
    "server": "./server.ts",
    "app": "./app.tsx"
  },
  "description": "Polls the tracker and forge of an Unattendish fleet and wakes its manager thread in bb when something it waits on changes.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/gperezmz/bb-plugins.git",
    "directory": "plugins/unattendish-sdlc"
  },
  "keywords": [
    "bb-plugin"
  ],
  "scripts": {
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "build": "bb plugin build",
    "notices": "node scripts/third-party-notices.mjs"
  },
  "files": [
    "dist",
    "icons",
    "server.ts",
    "tsconfig.json",
    "THIRD_PARTY_NOTICES.md",
    "app.tsx",
    "src",
    "features",
    "shared",
    "components",
    "lib",
    "!**/*.test.*"
  ],
  "dependencies": {
    "@radix-ui/react-slot": "^1.3.0",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@get-bb/plugin-sdk": "0.6.37",
    "@octokit/openapi-types": "^29.0.1",
    "@radix-ui/react-dialog": "^1.1.19",
    "@radix-ui/react-hover-card": "^1.1.19",
    "@radix-ui/react-tooltip": "^1.2.12",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/react": "^16.3.3",
    "@types/better-sqlite3": "^7.6.13",
    "@types/node": "^22.20.4",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.0.0",
    "better-sqlite3": "^12.11.1",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cron-parser": "^5.10.1",
    "esbuild": "0.28.2",
    "hono": "^4.13.9",
    "jsdom": "^30.1.1",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "sonner": "^1.7.4",
    "tailwind-merge": "^3.4.0",
    "typescript": "^7.0.2",
    "vitest": "^5.0.2"
  }
}
