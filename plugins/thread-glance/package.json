{
  "name": "@gperezmz/bb-plugin-thread-glance",
  "version": "0.8.0",
  "type": "module",
  "engines": {
    "bb": ">=0.43",
    "bbPluginSdk": ">=0.5.9"
  },
  "bb": {
    "name": "Thread Glance",
    "description": "Sidebar thread list that shows each thread's state, harness and child threads at a glance.",
    "branding": {
      "icon": "ListView"
    },
    "server": "./server.ts",
    "app": "./app.tsx",
    "skills": [
      "skills"
    ]
  },
  "dependencies": {
    "@dnd-kit/core": "^6.3.1",
    "@radix-ui/react-slot": "^1.3.0",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@get-bb/plugin-sdk": "0.5.9",
    "@radix-ui/react-alert-dialog": "^1.1.19",
    "@radix-ui/react-context-menu": "^2.3.3",
    "@radix-ui/react-dialog": "^1.1.19",
    "@radix-ui/react-dropdown-menu": "^2.1.20",
    "@radix-ui/react-hover-card": "^1.1.19",
    "@radix-ui/react-popover": "^1.1.19",
    "@tailwindcss/vite": "^4.3.3",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/react": "^16.3.3",
    "@types/better-sqlite3": "^7.6.12",
    "@types/node": "^22.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitest/browser-playwright": "5.0.1",
    "better-sqlite3": "^12.0.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cron-parser": "^5.5.0",
    "esbuild": "^0.28.2",
    "hono": "^4.11.9",
    "jsdom": "^30.1.1",
    "playwright": "^1.63.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "sonner": "^1.7.4",
    "tailwind-merge": "^3.4.0",
    "tailwindcss": "^4.3.3",
    "typescript": "^7.0.2",
    "vite": "^8.3.1",
    "vitest": "^5.0.1"
  },
  "description": "Sidebar thread list that shows each thread's state, harness and child threads at a glance.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/gperezmz/bb-plugins.git",
    "directory": "plugins/thread-glance"
  },
  "keywords": [
    "bb-plugin"
  ],
  "scripts": {
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "build": "bb plugin build",
    "notices": "node scripts/third-party-notices.mjs",
    "perf": "node -e \"require('node:fs').rmSync('perf/results',{recursive:true,force:true})\" && vitest run -c perf/vitest.config.ts --project harness && vitest run -c perf/vitest.browser.config.ts && vitest run -c perf/vitest.config.ts --project ledger"
  },
  "files": [
    "dist",
    "skills",
    "server.ts",
    "tsconfig.json",
    "THIRD_PARTY_NOTICES.md",
    "app.tsx",
    "server",
    "shared",
    "features",
    "components",
    "lib",
    "types",
    "!**/*.test.*"
  ]
}
