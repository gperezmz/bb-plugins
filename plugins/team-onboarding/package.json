{
  "name": "@gperezmz/bb-plugin-team-onboarding",
  "version": "0.1.1",
  "type": "module",
  "engines": {
    "bb": ">=0.43",
    "bbPluginSdk": ">=0.5.9"
  },
  "bb": {
    "name": "Team Onboarding",
    "description": "A live setup checklist for your team: GitHub access, SSH, agent logins, skills, plugins and tools on every machine, fixed for you where it can be.",
    "branding": {
      "icon": "ListTodo"
    },
    "server": "./server.ts",
    "host": "./host.ts",
    "app": "./app.tsx",
    "skills": [
      "skills"
    ]
  },
  "dependencies": {
    "@radix-ui/react-slot": "^1.3.0",
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/xterm": "^6.0.0",
    "yaml": "^2.9.1",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@get-bb/plugin-sdk": "0.5.9",
    "@pierre/diffs": "^1.2.9",
    "@radix-ui/react-alert-dialog": "^1.1.19",
    "@radix-ui/react-context-menu": "^2.3.3",
    "@radix-ui/react-dialog": "^1.1.19",
    "@radix-ui/react-dropdown-menu": "^2.1.20",
    "@radix-ui/react-hover-card": "^1.1.19",
    "@radix-ui/react-menubar": "^1.1.20",
    "@radix-ui/react-navigation-menu": "^1.2.18",
    "@radix-ui/react-popover": "^1.1.19",
    "@radix-ui/react-select": "^2.3.3",
    "@radix-ui/react-tooltip": "^1.2.12",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/react": "^16.3.3",
    "@types/better-sqlite3": "^7.6.12",
    "@types/node": "^22.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "better-sqlite3": "^12.0.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cron-parser": "^5.5.0",
    "hono": "^4.11.9",
    "jsdom": "^30.1.1",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "sonner": "^1.7.4",
    "tailwind-merge": "^3.4.0",
    "typescript": "^7.0.2",
    "vaul": "^1.1.2",
    "vitest": "^5.0.1"
  },
  "description": "A live team setup checklist for bb, driven by a manifest: GitHub, SSH, agents, skills, plugins, tools and team checks on every machine.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/gperezmz/bb-plugins.git",
    "directory": "plugins/team-onboarding"
  },
  "scripts": {
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "build": "bb plugin build",
    "schema": "node --import ./scripts/ts-resolve.mjs scripts/emit-schema.ts",
    "refresh-keys": "node scripts/refresh-github-keys.mjs",
    "notices": "node scripts/third-party-notices.mjs"
  },
  "files": [
    "dist",
    "skills",
    "server.ts",
    "tsconfig.json",
    "THIRD_PARTY_NOTICES.md",
    "app.tsx",
    "host.ts",
    "src",
    "components",
    "lib",
    "hooks",
    "schema",
    "examples",
    "!**/*.test.*"
  ]
}
