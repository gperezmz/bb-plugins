#!/bin/sh
# Scans the staged changes for secrets. Turn the hooks on with
#   git config core.hooksPath .githooks
if ! command -v gitleaks >/dev/null 2>&1; then
  echo "pre-commit: gitleaks is not installed, so staged changes were not scanned for secrets" >&2
  exit 0
fi
exec gitleaks git --staged --redact --no-banner --verbose --log-level warn
