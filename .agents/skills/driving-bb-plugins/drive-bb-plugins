#!/usr/bin/env bash
# Drives this repository's plugins in a throwaway bb: a bb server and a host
# daemon on a data directory of their own, the chosen plugins installed from a
# copy of the checkout, Claude Code threads answered by Cache Keeper's fake
# Anthropic API, and the bb web UI in headless Chromium. Never touches the
# user's own bb: every command runs with the variables that name a bb unset or
# pointed at the throwaway, and HOME inside the run's scratch directory.
# Never exhausts the machine: everything a run starts, Claude Code included,
# runs in a systemd user scope capped at DBP_MEMORY_MAX with no swap, so a run
# past its cap loses its own processes and nothing else, and `spawn` holds at
# most DBP_MAX_SESSIONS Claude Code sessions at once, releasing each after its
# turn.
#
# Reads: plugins/<id>/ in this checkout, where it runs `npm ci` for a plugin
# without node_modules; DBP_* in the environment (below).
# Writes: scratch in a mktemp directory under $DBP_SCRATCH_ROOT (removed by
# stop), evidence and process handles in .drives/<run>/ at the repository root
# (kept by stop), port claims in $DBP_SCRATCH_ROOT/ports (released by stop).
#
#   drive-bb-plugins start [--fixture <name>] <plugin>...
#                                                   start a run, print its name and URL; with
#                                                   --fixture, on a copy of that saved bb
#   drive-bb-plugins doctor [--run <run>]           exit 0 only when the run is worth driving
#   drive-bb-plugins bb [--run <run>] <label> -- <args>
#                                                   run `bb <args>` against the run, logged as evidence
#   drive-bb-plugins spawn [--run <run>] <label> <title> <prompt> [<parent-thread>] [--fail|--background|--hold <s>]
#                                                   make a Claude Code thread, print its id once its
#                                                   first turn has ended and its runtime is released;
#                                                   --fail ends that turn in error, --background leaves
#                                                   a command running and the runtime loaded, --hold
#                                                   prints the id while the turn works for <s> seconds
#   drive-bb-plugins seed [--run <run>] <shape.json> make the threads a shape file declares: quiet ones
#                                                   pending over HTTP with no turn, finished and unread
#                                                   ones forks, failed, working and background ones
#                                                   real turns
#   drive-bb-plugins release [--run <run>] <thread>  stop a --background thread and free its session
#   drive-bb-plugins machine [--run <run>] offline|online
#                                                   stop the run's host daemon, or start it again
#   drive-bb-plugins <plugin> [--run <run>] <verb> [<args>] [--second-window] [--reload] [--mobile] [--label <label>]
#                                                   one of the plugin's feature verbs in verbs/<plugin>.mjs;
#                                                   with no verb, lists them
#   drive-bb-plugins ui [--run <run>] <label> <steps.mjs> [--mobile]
#                                                   run a Playwright script against the bb web UI
#   drive-bb-plugins stop [--run <run>]             stop the run, keep its evidence
#   drive-bb-plugins save [--run <run>] <name>      stop the run and save its bb as fixture <name>
#   drive-bb-plugins fixtures                       list the saved fixtures of the bb on PATH
#
# The run is --run's, else $DBP_RUN's, else the one .drives/latest points at.
# start picks three free ports and claims them, so runs started at once from
# any checkouts never share one; DBP_SERVER_PORT, DBP_DAEMON_PORT and
# DBP_API_PORT pick them instead. Every later command reads the run's ports
# from its run.env.
#
# start refuses while less than DBP_MIN_FREE (default 4G) of memory is
# available once other runs have grown to their caps, caps the run at DBP_MEMORY_MAX (default 6G, swap 0), and refuses
# where no systemd user manager can run the scope, unless DBP_UNCAPPED=1.
# DBP_MAX_SESSIONS (default 4) is how many `spawn`s of the run hold a Claude
# Code session at once; the rest wait for a slot.
#
# Fixtures live in $DBP_FIXTURE_ROOT (default ~/.cache/drive-bb-plugins/fixtures),
# under the bb version that saved them, and are shared by every checkout.
set -euo pipefail

skill_dir=$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd -P)
repo=$(git -C "$skill_dir" rev-parse --show-toplevel)
evidence_root=$repo/.drives
scratch_root=${DBP_SCRATCH_ROOT:-${TMPDIR:-/tmp}/drive-bb-plugins}
claims=$scratch_root/ports
fixture_root=${DBP_FIXTURE_ROOT:-${XDG_CACHE_HOME:-$HOME/.cache}/drive-bb-plugins/fixtures}
unset_bb=(-u BB_SERVER_URL -u BB_THREAD_ID -u BB_PROJECT_ID -u BB_ENVIRONMENT_ID -u BB_CLI -u BB_HOST_DAEMON_PORT
  -u BB_THREAD_STORAGE -u BB_DATA_DIR -u CLAUDE_CONFIG_DIR -u ANTHROPIC_API_KEY -u ANTHROPIC_AUTH_TOKEN
  -u ANTHROPIC_BASE_URL -u CLAUDE_CODE_OAUTH_TOKEN)

die() { echo "drive-bb-plugins: $*" >&2; exit 1; }
# A size such as 6G, 512M or a byte count, in bytes.
to_bytes() { numfmt --from=iec "${1%[Bb]}" 2> /dev/null || die "'$1' is not a size such as 6G or 512M"; }
iec() { numfmt --to=iec "$1"; }
export XDG_RUNTIME_DIR=${XDG_RUNTIME_DIR:-/run/user/$(id -u)}
sysu() { systemctl --user "$@"; }
port_busy() { (exec 3<> "/dev/tcp/127.0.0.1/$1") 2> /dev/null; }
bb_version() { env "${unset_bb[@]}" bb --version; }
# One value from a saved fixture's fixture.env.
# shellcheck source=/dev/null
fixture_value() { (source "$1/fixture.env" && printf '%s' "${!2}"); }

# Resolves the run the command acts on into $run, $ev and $scratch, and loads
# its recorded settings.
load_run() {
  run=${DBP_RUN:-$(readlink "$evidence_root/latest" 2> /dev/null || true)}
  [[ -n $run && -f $evidence_root/$run/run.env ]] || die "no run found; start one with: drive-bb-plugins start <plugin>..."
  ev=$evidence_root/$run
  # shellcheck source=/dev/null
  source "$ev/run.env"
  [[ ${scratch:-} == "$scratch_root"/run.?????? && $scratch != *..* ]] ||
    die "$ev/run.env names no run directory under $scratch_root (scratch='${scratch:-}'); refusing to act on it"
}

# Every process whose environment carries this run's mark, "pid<TAB>cmdline".
# The bb server's detached child and the Claude Code the daemon starts inherit it.
marked_procs() {
  local proc pid
  for proc in /proc/[0-9]*; do
    pid=${proc#/proc/}
    [[ $pid == "$$" || $pid == "${BASHPID:-}" ]] && continue
    if grep -qzxF "DBP_MARK=$scratch" "$proc/environ" 2> /dev/null; then
      printf '%s\t%s\n' "$pid" "$(tr '\0\n\t' '   ' < "$proc/cmdline" 2> /dev/null | cut -c1-160)"
    fi
  done
}

# Removes the run's scratch directory, refusing any path that is not a run
# directory mktemp made under the scratch root, so a missing or edited run.env
# never deletes anything else.
remove_scratch() {
  [[ $scratch == "$scratch_root"/run.?????? && $scratch != *..* && -d $scratch && ! -L $scratch ]] ||
    die "refusing to remove '$scratch': not a run directory under $scratch_root"
  rm -rf "$scratch"
}

# Removes one port claim, refusing any path that is not $claims/<port>.
remove_claim() {
  local port=${1%/}
  port=${port#"$claims"/}
  [[ ${1%/} == "$claims/$port" && $port =~ ^[0-9]+$ && -d $claims/$port && ! -L $claims/$port ]] ||
    die "refusing to remove '$1': not a port claim under $claims"
  rm -rf "$claims/$port"
}

# Prints a free port, claimed for this run's scratch: the claim is a
# directory, made atomically, so two starts at once never take the same port.
# A claim whose run's scratch is gone is stale and taken over.
claim_port() {
  local port owner
  mkdir -p "$claims"
  for _ in $(seq 50); do
    port=$(node -e 'const s = require("net").createServer(); s.listen(0, "127.0.0.1", () => { console.log(s.address().port); s.close(); })')
    if mkdir "$claims/$port" 2> /dev/null; then
      echo "$scratch" > "$claims/$port/owner"
      echo "$port"
      return
    fi
    owner=$(cat "$claims/$port/owner" 2> /dev/null || true)
    [[ -n $owner && ! -d $owner ]] && remove_claim "$claims/$port"
  done
  die "no free port found"
}

# Releases the ports this run's scratch claimed.
release_ports() {
  local claim
  for claim in "$claims"/*/; do
    [[ $(cat "$claim/owner" 2> /dev/null) == "$scratch" ]] && remove_claim "$claim"
  done
  return 0
}

# Runs a command against the throwaway bb only.
tb() { env "${unset_bb[@]}" "DBP_MARK=$scratch" HOME="$scratch/home" TMPDIR="$scratch/tmp" BB_TELEMETRY=0 BB_SERVER_URL="$server_url" "$@"; }

cmd_start() {
  local fixture="" fixture_dir="" p
  if [[ ${1:-} == --fixture ]]; then
    fixture=${2:?--fixture needs a fixture name}
    shift 2
    fixture_dir=$fixture_root/bb-$(bb_version)/$fixture
    [[ -f $fixture_dir/fixture.env ]] || die "no fixture '$fixture' for bb $(bb_version) under $fixture_root; list them with: drive-bb-plugins fixtures"
    # shellcheck disable=SC2046 # the fixture's plugins are a space-separated list
    [[ $# -gt 0 ]] || set -- $(fixture_value "$fixture_dir" plugins)
  fi
  [[ $# -gt 0 ]] || die "usage: drive-bb-plugins start [--fixture <name>] <plugin>...  (plugins: $(ls "$repo/plugins" | tr '\n' ' '))"
  for p in "$@"; do [[ -f $repo/plugins/$p/package.json ]] || die "no plugin plugins/$p"; done
  for tool in node jq curl git rsync bb bb-server bb-host-daemon; do
    command -v "$tool" > /dev/null || die "$tool is not on PATH"
  done
  # A run's Claude Code sessions can take gigabytes; start none on a machine
  # already short of memory, and none a cap cannot hold.
  local min_free avail headroom=0 other max current memory_max="" unit="" max_sessions=${DBP_MAX_SESSIONS:-4}
  [[ $max_sessions =~ ^[1-9][0-9]*$ ]] || die "DBP_MAX_SESSIONS='$max_sessions' is not a positive number"
  min_free=$(to_bytes "${DBP_MIN_FREE:-4G}")
  # One start at a time checks memory and launches, so two starts never both
  # count memory the other is about to take.
  mkdir -p "$scratch_root"
  exec 7> "$scratch_root/start.lock"
  flock 7
  # Memory other runs may still grow into, up to their caps, is not free.
  for other in $(sysu list-units 'dbp-*.scope' --state=active --plain --no-legend 2> /dev/null | awk '{ print $1 }'); do
    max=$(sysu show "$other" -p MemoryMax --value) current=$(sysu show "$other" -p MemoryCurrent --value)
    [[ $max =~ ^[0-9]+$ && $current =~ ^[0-9]+$ ]] && ((max > current)) && headroom=$((headroom + max - current))
  done
  avail=$(($(awk '/^MemAvailable:/ { print $2 }' /proc/meminfo) * 1024 - headroom))
  ((avail >= min_free)) ||
    die "only $(iec "$((avail > 0 ? avail : 0))") of memory is available once other runs reach their caps ($(iec "$headroom") more), under the $(iec "$min_free") floor; stop another run (ls $scratch_root) or free memory first, or lower DBP_MIN_FREE"
  if systemd-run --user --scope --quiet -- true 2> /dev/null; then
    memory_max=$(to_bytes "${DBP_MEMORY_MAX:-6G}")
  elif [[ ${DBP_UNCAPPED:-} == 1 ]]; then
    echo "drive-bb-plugins: no systemd user manager; this run's memory is UNCAPPED (DBP_UNCAPPED=1)" >&2
  else
    die "no systemd user manager to cap the run's memory (systemd-run --user --scope failed with XDG_RUNTIME_DIR=$XDG_RUNTIME_DIR); set DBP_UNCAPPED=1 to start uncapped"
  fi
  # A fresh worktree has no Playwright yet; `ui` needs it.
  if [[ ! -d $repo/plugins/thread-glance/node_modules/playwright ]]; then
    echo "installing plugins/thread-glance's dependencies, for Playwright" >&2
    npm ci --prefix "$repo/plugins/thread-glance" --no-audit --no-fund > /dev/null || die "npm ci in plugins/thread-glance failed"
  fi
  # bb builds a path install from the files it finds and fetches no package,
  # so a plugin's dependencies come from its own node_modules.
  for p in "$@"; do
    if [[ ! -d $repo/plugins/$p/node_modules ]]; then
      echo "installing plugins/$p's dependencies" >&2
      npm ci --prefix "$repo/plugins/$p" --no-audit --no-fund > /dev/null || die "npm ci in plugins/$p failed"
    fi
  done

  scratch=$(mktemp -d "$scratch_root/run.XXXXXX")
  run=$(date +%Y%m%d-%H%M%S)-$(printf '%s' "$*" | tr ' ' '+')-${scratch##*.}
  ev=$evidence_root/$run
  server_port=${DBP_SERVER_PORT:-$(claim_port)}
  daemon_port=${DBP_DAEMON_PORT:-$(claim_port)}
  api_port=${DBP_API_PORT:-$(claim_port)}
  [[ -n $server_port && -n $daemon_port && -n $api_port ]] || { release_ports; remove_scratch; die "could not claim three ports"; }
  for p in "$server_port" "$daemon_port" "$api_port"; do
    ! port_busy "$p" || { release_ports; remove_scratch; die "port $p is in use: choose another DBP_*_PORT"; }
  done
  server_url=http://127.0.0.1:$server_port
  [[ -n $memory_max ]] && unit=dbp-${scratch##*.}.scope
  mkdir -p "$ev" "$scratch/home" "$scratch/tmp" "$scratch/plugins" "$scratch/work/demo"
  ln -sfn "$run" "$evidence_root/latest"
  cat > "$ev/run.env" << ENV
scratch=$scratch
server_url=$server_url
server_port=$server_port
daemon_port=$daemon_port
api_port=$api_port
plugins="$*"
unit=$unit
memory_max=$memory_max
max_sessions=$max_sessions
fixture=$fixture
ENV
  if [[ -n $fixture ]]; then
    restore_fixture "$fixture_dir"
    # The saved bb already knows its machine and project.
    printf 'host_id=%s\nproject=%s\n' "$(fixture_value "$fixture_dir" host_id)" "$(fixture_value "$fixture_dir" project)" >> "$ev/run.env"
  fi
  : > "$ev/pids"
  : > "$ev/launch-pids"

  # The fake API, bb server and host daemon start inside the run's scope, and
  # everything they start (plugins, Claude Code, its commands) stays in it,
  # so the kernel kills only this run's processes when it passes its cap, and
  # systemd then stops the rest of the scope. The scope outlives the launch.
  if [[ -n $unit ]]; then
    systemd-run --user --scope --quiet --unit "$unit" --description "drive-bb-plugins run $run" \
      -p MemoryMax="$memory_max" -p MemorySwapMax=0 -p OOMPolicy=stop -p Delegate=yes \
      -- env DBP_RUN="$run" bash "$skill_dir/drive-bb-plugins" _launch 7>&- || exit 1
  else
    DBP_RUN="$run" bash "$skill_dir/drive-bb-plugins" _launch 7>&- || exit 1
  fi
  exec 7>&-
  # shellcheck source=/dev/null
  source "$ev/run.env"
  local status
  # bb-server hands the server to a detached child; record it by the run's mark.
  marked_procs | cut -f1 >> "$ev/pids"
  sort -u "$ev/pids" -o "$ev/pids"
  # bb's own limit on threads running at once, as a second bound under spawn's.
  tb bb concurrency-limit global "$max_sessions" > /dev/null || fail "could not limit the run to $max_sessions running threads"

  if [[ -z $fixture ]]; then
    GIT_AUTHOR_NAME=drive GIT_AUTHOR_EMAIL=drive@example.invalid GIT_COMMITTER_NAME=drive GIT_COMMITTER_EMAIL=drive@example.invalid \
      bash -c 'git -C "$1" init -q && git -C "$1" commit -q --allow-empty -m drive' _ "$scratch/work/demo"
    project=$(tb bb project create --name drives --root "$scratch/work/demo" --machine "$host_id" --json | jq -r '.id // .project.id')
    [[ $project == proj_* ]] || fail "could not create the drives' project"
    echo "project=$project" >> "$ev/run.env"
  else
    # A plugin the fixture has and this run does not test would run from a
    # copy that is not there.
    for p in $(fixture_value "$fixture_dir" plugins); do
      [[ " $* " == *" $p "* ]] || tb bb plugin uninstall "$p" --yes > /dev/null || fail "could not uninstall the fixture's $p"
    done
  fi

  for p in "$@"; do
    # A copy as the checkout has it, so bb builds what is checked out and
    # writes nothing into the checkout. On a fixture this reinstalls the
    # plugin over the one the fixture saved.
    rsync -a --exclude node_modules --exclude dist --exclude harness "$repo/plugins/$p/" "$scratch/plugins/$p/"
    [[ -d $repo/plugins/$p/node_modules ]] && ln -s "$repo/plugins/$p/node_modules" "$scratch/plugins/$p/node_modules"
    tb bb plugin install "path:$scratch/plugins/$p" --yes > "$scratch/install-$p.log" 2>&1 || { cat "$scratch/install-$p.log" >&2; fail "could not install $p"; }
    status=$(tb bb plugin list --json | jq -r --arg id "$p" '.plugins[] | select(.id == $id) | .status')
    [[ $status == running ]] || fail "$p's status is '$status', not running"
  done
  marked_procs | cut -f1 >> "$ev/pids"
  sort -u "$ev/pids" -o "$ev/pids"

  cat > "$ev/env.sh" << ENV
# Points bb at run $run and nothing else. Source it in a subshell.
unset BB_THREAD_ID BB_PROJECT_ID BB_ENVIRONMENT_ID BB_CLI BB_HOST_DAEMON_PORT BB_THREAD_STORAGE BB_DATA_DIR
export BB_SERVER_URL=$server_url HOME=$scratch/home TMPDIR=$scratch/tmp DBP_MARK=$scratch
export DBP_PROJECT=$project DBP_HOST=$host_id DBP_API=http://127.0.0.1:$api_port
ENV
  echo "run      $run   (pass --run $run to every later command)"
  echo "web UI   $server_url/"
  echo "project  $project   machine $host_id"
  echo "plugins  $*"
  [[ -z $fixture ]] || echo "fixture  $fixture, restored from $fixture_dir"
  if [[ -n $unit ]]; then
    echo "memory   capped at $(iec "$memory_max"), no swap, in $unit; $max_sessions Claude Code sessions at once"
  else
    echo "memory   UNCAPPED; $max_sessions Claude Code sessions at once"
  fi
  echo "evidence $ev"
}

# Reports a failed start with the run's logs, and exits.
fail() {
  echo "drive-bb-plugins: $1" >&2
  for log in "$scratch/fake-anthropic.log" "$scratch/server.log" "$scratch/bb/logs/server-stdio.log" "$scratch/host-daemon.log"; do
    [[ -f $log ]] && { echo "--- $log" >&2; tail -30 "$log" >&2; }
  done
  echo "drive-bb-plugins: run 'drive-bb-plugins stop --run $run' to stop what started" >&2
  exit 1
}

# start's launch of the fake API, bb server and host daemon, inside the run's
# scope. Records the host in run.env.
cmd__launch() {
  load_run
  wait_for() {
    for _ in $(seq 60); do curl -fs -o /dev/null "$2" && return 0; sleep 1; done
    fail "$1 did not answer at $2"
  }

  tb env PORT="$api_port" REQUEST_LOG="$scratch/requests.jsonl" \
    node "$repo/plugins/cache-keeper/harness/fake-anthropic.mjs" > "$scratch/fake-anthropic.log" 2>&1 &
  echo $! | tee -a "$ev/pids" >> "$ev/launch-pids"
  wait_for "the fake Anthropic API" "http://127.0.0.1:$api_port/_control"

  tb env CACHE_KEEPER_DRIVE_CLOCK=1 BB_HOST_DAEMON_PORT="$daemon_port" \
    bb-server --data-dir "$scratch/bb" --server-bind-host 127.0.0.1 --server-port "$server_port" > "$scratch/server.log" 2>&1 &
  echo $! | tee -a "$ev/pids" >> "$ev/launch-pids"
  wait_for "the bb server" "$server_url/health"

  local enroll
  if [[ -n ${host_id:-} ]]; then
    # A restored fixture's daemon signs in with the credentials it saved.
    start_daemon &
  else
    enroll=$(curl -fsS -X POST -H 'Content-Type: application/json' -d '{}' "$server_url/internal/hosts/enroll-key") || fail "the bb server gave no host enroll key"
    host_id=$(jq -r .hostId <<< "$enroll")
    echo "host_id=$host_id" >> "$ev/run.env"
    start_daemon BB_HOST_ENROLL_KEY="$(jq -r .enrollKey <<< "$enroll")" &
  fi
  echo $! | tee -a "$ev/pids" >> "$ev/launch-pids"
  for _ in $(seq 60); do connected && break; sleep 1; done
  connected || fail "the host daemon did not connect to the bb server"
}

# Copies a saved fixture into this run's scratch and points every absolute
# path it saved at this run's scratch instead. bb.db keeps them in project,
# environment, plugin and daemon rows and in event history; Claude Code keeps
# its sessions under a directory named after the project path, with every /
# and . turned to -.
restore_fixture() {
  local from=$1 old old_dashed new_dashed dir
  old=$(fixture_value "$from" scratch)
  [[ $old == */run.?????? ]] || fail "$from/fixture.env names no scratch directory"
  old_dashed=${old//[^A-Za-z0-9]/-} new_dashed=${scratch//[^A-Za-z0-9]/-}
  rm -rf "${scratch:?}/work"
  # Shared with other starts, exclusive against a save replacing the fixture.
  (
    flock -s 6
    cp -a "$from/bb" "$from/work" "$scratch/" && cp -a "$from/home/." "$scratch/home/"
  ) 6> "${from%/*}/.lock" || fail "could not copy fixture $from"
  # shellcheck disable=SC2016 # the script is JavaScript
  node --no-warnings -e '
    const { DatabaseSync } = require("node:sqlite");
    const [file, ...pairs] = process.argv.slice(1);
    const db = new DatabaseSync(file);
    const q = (name) => `"${name.replaceAll(`"`, `""`)}"`;
    for (const { name } of db.prepare("select name from sqlite_master where type = ? and name not like ?").all("table", "sqlite_%")) {
      for (const col of db.prepare(`pragma table_info(${q(name)})`).all()) {
        if (!/TEXT|CHAR|CLOB|JSON|^$/i.test(col.type)) continue;
        try {
          for (let i = 0; i < pairs.length; i += 2) {
            const [from, to] = pairs.slice(i, i + 2);
            db.prepare(`update ${q(name)} set ${q(col.name)} = replace(${q(col.name)}, ?, ?) where instr(${q(col.name)}, ?) > 0`).run(from, to, from);
          }
        } catch (e) {
          // A full-text index table follows its content table and takes no writes.
          if (!/may not be modified/.test(e.message)) throw e;
        }
      }
    }
    db.close();
  ' "$scratch/bb/bb.db" "$old" "$scratch" "$old_dashed" "$new_dashed" || fail "could not point the fixture's bb.db at $scratch"
  for dir in "$scratch/home/.claude/projects/$old_dashed"*; do
    [[ -e $dir ]] && mv "$dir" "$scratch/home/.claude/projects/$new_dashed${dir#"$scratch/home/.claude/projects/$old_dashed"}"
  done
  { grep -rlIZF -e "$old" -e "$old_dashed" --exclude='bb.db*' "$scratch/bb" "$scratch/home" || true; } |
    xargs -0 -r sed -i -e "s|$old|$scratch|g" -e "s|$old_dashed|$new_dashed|g"
  return 0
}

# Execs the run's host daemon, as machine $host_id, with any extra environment
# given. Run it in a subshell: it replaces the shell.
start_daemon() {
  exec env "${unset_bb[@]}" "DBP_MARK=$scratch" HOME="$scratch/home" TMPDIR="$scratch/tmp" BB_TELEMETRY=0 BB_SERVER_URL="$server_url" \
    CACHE_KEEPER_DRIVE_CLOCK=1 BB_DATA_DIR="$scratch/bb" BB_HOST_DAEMON_PORT="$daemon_port" BB_HOST_ID="$host_id" "$@" \
    ANTHROPIC_BASE_URL="http://127.0.0.1:$api_port" ANTHROPIC_API_KEY=sk-ant-drive-fake \
    CLAUDE_CODE_DISABLE_NONESSENTIAL_TRAFFIC=1 DISABLE_AUTOUPDATER=1 \
    bb-host-daemon --server-url "$server_url" --host-daemon-port "$daemon_port" >> "$scratch/host-daemon.log" 2>&1 < /dev/null
}

connected() { [[ $(tb bb machine list --json | jq --arg id "$host_id" '[.[] | select(.id == $id and .status == "connected")] | length') -gt 0 ]]; }

# Takes the run's machine offline by stopping its host daemon, and with it
# every Claude Code session and command it runs, or starts the daemon again
# inside the run's scope. The machine reconnects as the same host.
cmd_machine() {
  load_run
  local want=${1:?usage: drive-bb-plugins machine offline|online} pid
  pid=$(sed -n 3p "$ev/launch-pids")
  case $want in
    offline)
      if [[ -n $pid ]] && grep -qzxF "DBP_MARK=$scratch" "/proc/$pid/environ" 2> /dev/null; then kill "$pid"; fi
      for _ in $(seq 30); do connected || break; sleep 1; done
      ! connected || die "machine $host_id is still connected"
      echo "machine $host_id offline"
      ;;
    online)
      connected && { echo "machine $host_id online"; return 0; }
      # Stopped before it runs, so it is inside the scope before it starts anything.
      (kill -STOP "$BASHPID"; start_daemon) &
      pid=$!
      for _ in $(seq 50); do [[ $(awk '{ print $3 }' "/proc/$pid/stat" 2> /dev/null) == T ]] && break; sleep 0.1; done
      if [[ -n ${unit:-} ]]; then
        busctl --user call org.freedesktop.systemd1 /org/freedesktop/systemd1 org.freedesktop.systemd1.Manager \
          AttachProcessesToUnit ssau "$unit" / 1 "$pid" > /dev/null ||
          { kill -9 "$pid"; die "could not move the host daemon into $unit; a run started before scopes were delegated cannot restart it: stop it and start again"; }
      fi
      kill -CONT "$pid"
      sed -i "3s/.*/$pid/" "$ev/launch-pids"
      echo "$pid" >> "$ev/pids"
      for _ in $(seq 60); do connected && break; sleep 1; done
      connected || die "the host daemon did not reconnect; see $scratch/host-daemon.log"
      echo "machine $host_id online"
      ;;
    *) die "usage: drive-bb-plugins machine offline|online" ;;
  esac
}

cmd_doctor() {
  load_run
  local bad=0 p row
  check() { if eval "$2" 2> /dev/null; then echo "ok   $1"; else echo "FAIL $1"; bad=1; fi; }
  check "run $run points at $server_url, not the user's bb (${BB_SERVER_URL:-unset})" '[[ $server_url != "${BB_SERVER_URL:-}" ]]'
  if [[ -n ${unit:-} ]]; then
    local state
    state=$(sysu show "$unit" -p ActiveState -p Result --value 2> /dev/null | paste -sd/ -)
    check "the run's scope $unit is active (${state:-not loaded}; oom-kill means the run passed its cap: stop it, start again with fewer sessions or a larger DBP_MEMORY_MAX)" '[[ $state == active/* ]]'
    check "$unit caps memory at $(iec "$memory_max") with no swap" \
      '[[ $(sysu show "$unit" -p MemoryMax --value) == "$memory_max" && $(sysu show "$unit" -p MemorySwapMax --value) == 0 ]]'
    check "the run's bb server is inside $unit" \
      'grep -qx "0::.*/$unit" /proc/$(ss -ltnpH "sport = :$server_port" | grep -o "pid=[0-9]*" | head -1 | cut -d= -f2)/cgroup'
  else
    echo "warn run $run is UNCAPPED: nothing bounds its memory but spawn's $max_sessions sessions"
  fi
  check "the fake API, bb server and host daemon launched for the run are alive" '[[ $(ps -p "$(paste -sd, - < "$ev/launch-pids")" -o pid= | wc -l) -eq 3 ]]'
  check "the bb server answers /health" 'curl -fs -o /dev/null "$server_url/health"'
  check "the server on $server_port serves the run's data dir" 'grep -qzxF "DBP_MARK=$scratch" /proc/$(ss -ltnpH "sport = :$server_port" | grep -o "pid=[0-9]*" | head -1 | cut -d= -f2)/environ'
  check "machine $host_id is connected" '[[ $(tb bb machine list --json | jq --arg id "$host_id" "[.[] | select(.id == \$id and .status == \"connected\")] | length") -gt 0 ]]'
  for p in $plugins; do
    row=$(tb bb plugin list --json | jq -c --arg id "$p" '.plugins[] | select(.id == $id)')
    check "$p runs from the run's copy" '[[ $(jq -r .status <<< "$row") == running && $(jq -r .rootDir <<< "$row") == "$scratch/plugins/$p"* ]]'
  done
  return $bad
}

cmd_bb() {
  load_run
  local label=${1:?usage: drive-bb-plugins bb <label> -- <bb args>}
  shift
  [[ ${1:-} == -- ]] && shift
  [[ ${1:-} != thread || ! ${2:-} =~ ^(spawn|create)$ || ${DBP_IN_SPAWN:-} == 1 ]] ||
    die "make threads with 'drive-bb-plugins spawn', which bounds and releases their Claude Code sessions"
  local out err code=0
  out=$(mktemp) err=$(mktemp)
  tb bb "$@" > "$out" 2> "$err" || code=$?
  cat "$out"
  cat "$err" >&2
  {
    printf '### %s  %s\n$ bb' "$label" "$(date -Iseconds)"
    printf ' %q' "$@"
    printf '\nexit %s\n--- stdout\n%s\n--- stderr\n%s\n\n' "$code" "$(cat "$out")" "$(cat "$err")"
  } >> "$ev/cli.md"
  rm -f "$out" "$err"
  return $code
}

# Holds one of the run's $max_sessions session slots on fd 9 until this
# process exits, waiting while every slot is held by another spawn.
take_session_slot() {
  local i
  mkdir -p "$ev/slots"
  while :; do
    for i in $(seq "$max_sessions"); do
      exec 9> "$ev/slots/$i"
      flock -n 9 && return 0
      exec 9>&-
    done
    sleep 1
  done
}

cmd_spawn() {
  load_run
  local mode="" hold="" pos=()
  while [[ $# -gt 0 ]]; do
    case $1 in
      --fail | --background) mode=${1#--} ;;
      --hold) mode=hold hold=${2:?--hold needs seconds} && shift ;;
      *) pos+=("$1") ;;
    esac
    shift
  done
  set -- "${pos[@]}"
  local label=${1:?usage: drive-bb-plugins spawn <label> <title> <prompt> [<parent-thread>] [--fail|--background|--hold <s>]} title=${2:?} prompt=${3:?} parent=${4:-} parent_env="" args id idle=0 want=idle
  # The fake API reads these markers in the prompt (plugins/cache-keeper/harness/README.md).
  case $mode in
    fail) prompt+=" [fake: fail]" want=error ;;
    background) prompt+=" [fake: background]" ;;
    hold) [[ $hold =~ ^[0-9]+$ ]] || die "--hold takes whole seconds"; prompt+=" [fake: hold=$hold]" ;;
  esac
  args=(--project "$project" --provider claude-code --model "claude-opus-5-5[1m]" --title "$title" --json)
  # A child shares its parent's checkout; a seeded parent never ran and has none.
  if [[ -n $parent ]]; then
    args+=(--parent-thread "$parent")
    parent_env=$(tb bb thread show "$parent" --json | jq -r '.environment.id // empty') || die "no parent thread $parent"
  fi
  if [[ -n ${parent_env:-} ]]; then
    args+=(--environment "$parent_env")
  else
    args+=(--machine "$host_id" --environment-provider project-checkout)
  fi
  # bb keeps a thread's Claude Code loaded after its turn; the slot bounds how
  # many run at once, and `thread stop` releases each before the slot frees.
  take_session_slot
  # bb fails a thread whose checkout another thread is still provisioning,
  # so one spawn at a time holds the run's provisioning lock until its thread
  # has left `starting`.
  exec 8> "$ev/slots/provisioning"
  flock 8
  id=$(DBP_IN_SPAWN=1 cmd_bb "$label" -- thread spawn "${args[@]}" --prompt "$prompt" 8>&- 9>&- | jq -r '.id // .thread.id')
  [[ $id == thr_* ]] || die "bb made no thread"
  for _ in $(seq 300); do
    [[ $(tb bb thread show "$id" --json 8>&- 9>&- | jq -r .thread.status) != starting ]] && break
    sleep 0.2
  done
  exec 8>&-
  if [[ $mode == hold ]]; then
    # The turn is working; a process that inherits the session slot releases
    # the runtime, and the slot, once the turn ends.
    tb bash -c 'bb thread wait "$1" --status idle --timeout "$2"; bb thread stop "$1"' _ "$id" "$((hold + 120))s" < /dev/null > /dev/null 2>&1 &
    echo "$!" >> "$ev/pids"
    echo "$id"
    return 0
  fi
  tb bb thread wait "$id" --status "$want" --timeout 60s > /dev/null 9>&- && idle=1
  if [[ $mode == background ]] && ((idle)); then
    # The runtime stays loaded to keep the command running, so the session
    # slot stays held, by a process that inherits it, until release.
    (exec -a "dbp-slot-$id" env "DBP_MARK=$scratch" sleep infinity 8>&- < /dev/null > /dev/null 2>&1) &
    echo "$id $!" >> "$ev/kept"
    echo "$!" >> "$ev/pids"
    echo "$id"
    return 0
  fi
  tb bb thread stop "$id" > /dev/null 9>&- || die "could not release $id's runtime"
  ((idle)) || die "$id did not reach $want within 60s; its runtime is released"
  echo "$id"
}

# Makes the threads a shape file declares; see SKILL.md for the shape. Quiet
# threads come from seed.mjs with no turn. Finished and unread ones are forks
# of one real turn: a fork runs no turn but loads a Claude Code session until
# stopped, and bb 0.44 corrupts forks made 8 at once, so at most 4 fork at
# once. Failed, working and background threads each run the real turn only
# they can come from. Writes what it made to seed.json in the evidence.
cmd_seed() {
  load_run
  local shape=${1:?usage: drive-bb-plugins seed <shape.json>} started=$SECONDS quiet made states failed working background finished unread hold width src="" i pid bad=0
  [[ -f $shape ]] || die "no shape file $shape"
  jq -e '(keys - ["trees", "states", "hold"] | length == 0)
    and ((.states // {}) | keys - ["failed", "working", "background", "finished", "unread"] | length == 0)
    and all((.trees // [])[]; keys - ["count", "children", "archived", "section", "title"] | length == 0)' "$shape" > /dev/null ||
    die "$shape holds a key a shape does not have (trees[].count|children|archived|section|title, states.failed|working|background|finished|unread, hold)"
  read -r failed working background finished unread hold < <(jq -r '[.states.failed, .states.working, .states.background, .states.finished, .states.unread, .hold // 600 | . // 0] | @tsv' "$shape")
  for i in "$failed" "$working" "$background" "$finished" "$unread" "$hold"; do [[ $i =~ ^[0-9]+$ ]] || die "'$i' in $shape is not a whole number"; done
  # A background thread keeps its session slot until released, and a working
  # one until its turn ends, so more of them than free slots would wait forever.
  local free=0
  mkdir -p "$ev/slots"
  for i in $(seq "$max_sessions"); do (exec 9> "$ev/slots/$i" && flock -n 9) && free=$((free + 1)); done
  ((working + background <= free)) ||
    die "$((working + background)) working and background threads need that many session slots, and $free of the run's $max_sessions are free; release --background threads or wait for working ones first"
  made=$ev/seed.tsv
  : > "$made"
  # Titles number on past the ones the run already has, so each stays unique.
  tb bb thread section list --json > "$ev/seed-existing.json"
  tb bb thread list --json | jq --slurpfile sections "$ev/seed-existing.json" '{ titles: [.[].title], sections: $sections[0] }' > "$ev/seed-existing.json.new"
  mv "$ev/seed-existing.json.new" "$ev/seed-existing.json"
  next() { jq -r --arg s "$1" '[.titles[] | capture("^" + $s + " (?<n>[0-9]+)$") | .n | tonumber] | max // 0' "$ev/seed-existing.json"; }
  local nf nw nb nd nu
  nf=$(next failed) nw=$(next working) nb=$(next background) nd=$(next finished) nu=$(next unread)

  quiet=$(env "${unset_bb[@]}" DBP_URL="$server_url/" DBP_PROJECT="$project" DBP_HOST="$host_id" DBP_EXISTING="$ev/seed-existing.json" node "$skill_dir/seed.mjs" "$(realpath "$shape")") ||
    { rm -f "$made" "$ev/seed-existing.json"; die "seeding the quiet threads failed; any it made before failing are in the run, still pending with a message due in 2099"; }
  echo "quiet      $(jq -r '"\(.created) threads, \(.archived) of them archived, in \(.ms / 1000) s"' <<< "$quiet")"

  # Each state thread in its own process; spawn's session slots bound them.
  spawn_state() {
    local state=$1 title=$2 id
    shift 2
    id=$(cmd_spawn "seed/$state" "$title" hi "$@") && printf '%s\t%s\t%s\n' "$state" "$title" "$id" >> "$made"
  }
  # At most one process per session slot waits for one at a time.
  local pids=()
  start_state() {
    if ((${#pids[@]} >= max_sessions)); then
      wait "${pids[0]}" || bad=1
      pids=("${pids[@]:1}")
    fi
    spawn_state "$@" &
    pids+=($!)
  }
  finish_states() {
    for pid in "${pids[@]}"; do wait "$pid" || bad=1; done
    pids=()
  }
  for i in $(seq "$failed"); do start_state failed "failed $((nf + i))" --fail; done
  if ((finished + unread > 0)); then
    # The fork source is the first finished thread, or the first unread one.
    if ((finished > 0)); then src="finished $((nd + 1))"; else src="unread $((nu + 1))"; fi
    start_state "${src% *}" "$src"
  fi
  finish_states
  if [[ -n $src ]]; then
    src=$(awk -F '\t' -v t="$src" '$2 == t { print $3 }' "$made")
    [[ $src == thr_* ]] || die "the fork source did not finish its turn"
    # A turn ending leaves its thread unread.
    ((finished > 0)) && { tb bb thread read "$src" > /dev/null || die "could not mark $src read"; }
    width=$((max_sessions < 4 ? max_sessions : 4))
    {
      for i in $(seq 2 "$finished"); do printf 'finished %s\nfinished\n' "$((nd + i))"; done
      for i in $(seq "$((finished > 0 ? 1 : 2))" "$unread"); do printf 'unread %s\nunread\n' "$((nu + i))"; done
    } | xargs -d '\n' -r -n 2 -P "$width" bash "$skill_dir/drive-bb-plugins" _fork --run "$run" "$src" >> "$made" || bad=1
  fi
  for i in $(seq "$background"); do start_state background "background $((nb + i))" --background; done
  for i in $(seq "$working"); do start_state working "working $((nw + i))" --hold "$hold"; done
  finish_states

  states=$(jq -Rn '[inputs | split("\t") | { state: .[0], title: .[1], id: .[2] }] | group_by(.state) | map({ (.[0].state): map({ title, id }) }) | add // {}' < "$made")
  jq --argjson states "$states" --argjson seconds "$((SECONDS - started))" '{ seconds: $seconds, quiet: ., states: $states }' <<< "$quiet" > "$ev/seed.json"
  rm -f "$made" "$ev/seed-existing.json"
  echo "states     $(jq -r 'to_entries | map("\(.value | length) \(.key)") | join(", ") | if . == "" then "none" else . end' <<< "$states")"
  echo "seeded in $((SECONDS - started)) s; ids in $ev/seed.json"
  ((bad == 0)) || die "some state threads were not made; see $ev/cli.md"
}

# seed's fork worker: forks <source> as <title>, releases the fork's session,
# and leaves it read (finished) or marks it unread. Prints
# "<state><TAB><title><TAB><id>".
cmd__fork() {
  load_run
  local src=$1 title=$2 state=$3 id
  take_session_slot
  id=$(cmd_bb seed/fork -- thread fork "$src" --title "$title" --json 9>&- | jq -r '.id // .thread.id')
  [[ $id == thr_* ]] || die "bb made no fork of $src"
  for _ in $(seq 300); do
    [[ $(tb bb thread show "$id" --json 9>&- | jq -r .thread.status) != starting ]] && break
    sleep 0.2
  done
  tb bb thread stop "$id" > /dev/null 9>&- || die "could not release $id's runtime"
  [[ $state == finished ]] || tb bb thread unread "$id" > /dev/null || die "could not mark $id unread"
  printf '%s\t%s\t%s\n' "$state" "$title" "$id"
}

# Stops the run and saves its bb as a fixture: the data directory, the
# project's repository and Claude Code's sessions, with the scratch path they
# name, so start --fixture can point them at another run's.
cmd_save() {
  load_run
  local name=${1:?usage: drive-bb-plugins save <name>} busy counts
  [[ $name =~ ^[A-Za-z0-9][A-Za-z0-9._-]*$ ]] || die "a fixture name is letters, digits, '.', '_' and '-'"
  [[ ! -s $ev/kept ]] || die "a --background thread is running a command a saved bb would lose; release it first"
  busy=$(tb bb thread list --json | jq -r '[.[] | select(.status | IN("idle", "pending", "error") | not) | "\(.title) (\(.status))"] | join(", ")')
  [[ -z $busy ]] || die "threads are still running, which a saved bb would lose: $busy"
  counts=$(tb bb thread list --json | jq -r '"threads=\(length)\narchived=\([.[] | select(.archivedAt != null)] | length)"')
  save_to=$fixture_root/bb-$(bb_version)/$name
  mkdir -p "${save_to%/*}"
  save_env="scratch=$scratch
host_id=$host_id
project=$project
plugins=\"$plugins\"
bb_version=$(bb_version)
saved=$(date -Iseconds)
from_run=$run
$counts"
  cmd_stop
}

# The part of stop that saves the fixture, once nothing of the run is left
# running. Replaces a fixture of the same name.
save_fixture() {
  local tmp old=""
  tmp=$(mktemp -d "${save_to%/*}/.saving.XXXXXX")
  (
    rsync -a --exclude /logs --exclude '/daemon.lock*' --exclude /desktop-browser-broker.json "$scratch/bb/" "$tmp/bb/" &&
      rsync -a "$scratch/work/" "$tmp/work/" && mkdir "$tmp/home" || exit 1
    for f in .claude .claude.json; do [[ ! -e $scratch/home/$f ]] || cp -a "$scratch/home/$f" "$tmp/home/" || exit 1; done
    printf '%s\n' "$save_env" > "$tmp/fixture.env"
  ) || {
    rm -rf "$tmp"
    die "could not save the fixture; the run is stopped and its scratch kept: finish with drive-bb-plugins stop --run $run"
  }
  # Exclusive against a start copying the fixture and another save of it.
  exec 6> "${save_to%/*}/.lock"
  flock 6
  if [[ -e $save_to ]]; then
    old=$(mktemp -d "${save_to%/*}/.replaced.XXXXXX")
    mv -T "$save_to" "$old/fixture"
  fi
  mv -T "$tmp" "$save_to"
  exec 6>&-
  [[ -z $old ]] || rm -rf "$old"
  echo "saved fixture $(basename "$save_to") in $save_to ($(du -sh "$save_to" | cut -f1))"
}

cmd_fixtures() {
  local version dir
  version=$(bb_version)
  for dir in "$fixture_root/bb-$version"/*/; do
    [[ -f $dir/fixture.env ]] || continue
    (
      # shellcheck source=/dev/null
      source "$dir/fixture.env"
      # shellcheck disable=SC2154 # set by fixture.env
      printf '%-24s %s threads, %s archived; plugins %s; saved %s from %s\n' "$(basename "$dir")" "$threads" "$archived" "$plugins" "$saved" "$from_run"
    )
  done
  echo "(fixtures of bb $version in $fixture_root/bb-$version)"
}

# Stops a --background thread's runtime, its command with it, and frees the
# session slot it held.
cmd_release() {
  load_run
  local id=${1:?usage: drive-bb-plugins release <thread>} holder
  holder=$(awk -v id="$id" '$1 == id { print $2 }' "$ev/kept" 2> /dev/null)
  [[ -n $holder ]] || die "$id was not spawned with --background in run $run"
  tb bb thread stop "$id" > /dev/null || die "could not release $id's runtime"
  grep -qzxF "DBP_MARK=$scratch" "/proc/$holder/environ" 2> /dev/null && kill "$holder"
  sed -i "/^$id /d" "$ev/kept"
  echo "released $id"
}

cmd_ui() {
  load_run
  local label=${1:?usage: drive-bb-plugins ui <label> <steps.mjs> [--mobile]} steps=${2:?usage: drive-bb-plugins ui <label> <steps.mjs> [--mobile]}
  local mobile=${3:-}
  local playwright=$repo/plugins/thread-glance/node_modules/playwright
  [[ -d $playwright ]] || die "Playwright is missing: run 'npm install' in plugins/thread-glance"
  mkdir -p "$ev/ui/$label"
  cp "$steps" "$ev/ui/$label/steps.mjs"
  env "${unset_bb[@]}" DBP_HARNESS="$skill_dir/drive-bb-plugins" DBP_SKILL="$skill_dir" DBP_RUN="$run" DBP_URL="$server_url/" DBP_OUT="$ev/ui/$label" DBP_PLAYWRIGHT="$playwright" DBP_MOBILE="${mobile:+1}" \
    CHROMIUM_PATH="${CHROMIUM_PATH:-$(command -v chromium || true)}" node "$skill_dir/browser.mjs" steps "$(realpath "$steps")"
}

# Runs one of a plugin's feature verbs from verbs/<plugin>.mjs; the verb picks
# its own evidence directory under ui/ and prints what it saw as JSON.
cmd_verb() {
  load_run
  local plugin=$1
  shift
  local playwright=$repo/plugins/thread-glance/node_modules/playwright
  [[ -d $playwright ]] || die "Playwright is missing: run 'npm install' in plugins/thread-glance"
  env "${unset_bb[@]}" DBP_HARNESS="$skill_dir/drive-bb-plugins" DBP_SKILL="$skill_dir" DBP_RUN="$run" DBP_URL="$server_url/" DBP_UI="$ev/ui" DBP_PLAYWRIGHT="$playwright" \
    CHROMIUM_PATH="${CHROMIUM_PATH:-$(command -v chromium || true)}" node "$skill_dir/browser.mjs" verb "$skill_dir/verbs/$plugin.mjs" "$@"
}

cmd_stop() {
  load_run
  local pid cmd left
  # Keep bb's own logs with the evidence before the scratch goes.
  if curl -fs -o /dev/null "$server_url/health"; then
    for p in $plugins; do tb bb plugin logs "$p" -n 100000 > "$ev/plugin-$p.log" 2>&1 || true; done
  fi
  for log in server.log host-daemon.log fake-anthropic.log requests.jsonl; do
    [[ -f $scratch/$log ]] && cp "$scratch/$log" "$ev/$log"
  done
  # Anything the run started after launch (Claude Code, its commands) joins
  # the recorded handles before the kill.
  marked_procs | cut -f1 >> "$ev/pids"
  sort -u "$ev/pids" -o "$ev/pids"
  # A recorded PID is killed only while it still carries the run's mark, so a
  # PID the system reused for another process is left alone.
  ours() { grep -qzxF "DBP_MARK=$scratch" "/proc/$1/environ" 2> /dev/null; }
  while read -r pid; do
    [[ -n $pid ]] && ours "$pid" && kill "$pid" 2> /dev/null && echo "stopped $pid"
  done < "$ev/pids"
  for _ in $(seq 20); do [[ -z $(marked_procs) ]] && break; sleep 0.5; done
  while read -r pid; do [[ -n $pid ]] && ours "$pid" && kill -9 "$pid" 2> /dev/null && echo "killed $pid"; done < "$ev/pids"
  # The scope holds what the run started, marked or not; stopping it ends
  # the rest, and resetting it unloads a scope that ended by oom-kill.
  if [[ -n ${unit:-} ]]; then
    sysu stop "$unit" 2> /dev/null || true
    sysu reset-failed "$unit" 2> /dev/null || true
  fi
  sleep 0.5
  left=$(marked_procs)
  if [[ -n $left ]]; then
    echo "drive-bb-plugins: still running, scratch kept at $scratch:" >&2
    echo "$left" >&2
    return 1
  fi
  [[ -z ${save_to:-} ]] || save_fixture
  release_ports
  remove_scratch
  echo "run $run stopped; evidence kept in $ev"
}

case ${1:-} in
  start | doctor | bb | spawn | seed | release | machine | ui | stop | save | fixtures | _launch | _fork)
    c=$1
    shift
    if [[ ${1:-} == --run ]]; then
      [[ $c != start ]] || die "start makes a new run; --run names an existing one"
      export DBP_RUN=${2:?--run needs a run name}
      shift 2
    fi
    "cmd_$c" "$@"
    ;;
  *)
    if [[ -n ${1:-} && -f $skill_dir/verbs/$1.mjs ]]; then
      p=$1
      shift
      if [[ ${1:-} == --run ]]; then
        export DBP_RUN=${2:?--run needs a run name}
        shift 2
      fi
      cmd_verb "$p" "$@"
      exit
    fi
    sed -n '2,/^set -euo/p' "$0" | sed '$d; s/^# \{0,1\}//'
    exit 2
    ;;
esac
